<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Built-in Material Light, no action bar (the screens draw their own bar), no AppCompat. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/eink_bg</item>
        <item name="android:colorBackground">@color/eink_bg</item>
        <item name="android:colorAccent">@color/eink_fg</item>
        <item name="android:colorPrimary">@color/eink_bar</item>
        <item name="android:colorPrimaryDark">@color/eink_fg</item>
        <item name="android:textColorPrimary">@color/eink_fg</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Settings: system action bar with a ← -->
    <style name="ScreenTheme" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:windowBackground">@color/eink_bg</item>
        <item name="android:colorBackground">@color/eink_bg</item>
        <item name="android:colorAccent">@color/eink_fg</item>
        <item name="android:colorPrimary">@color/eink_fg</item>
        <item name="android:colorPrimaryDark">@color/eink_fg</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="BarIcon" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="BarButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/eink_fg</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
